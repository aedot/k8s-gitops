{{/*
  Render the app's HelmRelease .spec.values for bootstrap. Flux post-build vars
  like ${SECRET_DOMAIN} are not substituted here (no Flux yet), so replace the
  known one with $SECRET_DOMAIN (if exported) or a valid placeholder — Flux
  re-reconciles these apps afterward and applies the real value.
*/ -}}
{{ (fromYaml (readFile (printf "../../../kubernetes/apps/%s/%s/app/helmrelease.yaml" .Release.Namespace .Release.Name))).spec.values | toYaml | replace "${SECRET_DOMAIN}" (env "SECRET_DOMAIN" | default "bootstrap.local") }}
